#!/bin/bash
# 汽水快手自动化 启动器
# 项目主目录已迁到外接固态硬盘：/Volumes/wlkj/汽水音乐去广告+快手自动化
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
FIXED="/Volumes/wlkj/汽水音乐去广告+快手自动化"
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../../.." 2>/dev/null && pwd)"

# 优先用本 App 所在的项目目录；失效（外接盘未挂载/App 被单独拷贝）时回退固定路径
if [ ! -f "$REPO/qishui_ad_gui.py" ]; then
  REPO="$FIXED"
fi
if [ ! -f "$REPO/qishui_ad_gui.py" ]; then
  /usr/bin/osascript -e 'display alert "未找到程序" message "外接硬盘 wlkj 没有挂载，或项目目录被移动了。请插上 WLKJ 固态硬盘后重试。" as critical'
  exit 1
fi
cd "$REPO" || exit 1
exec "$REPO/.venv/bin/python" "$REPO/qishui_ad_gui.py"
